{
  "name": "portlight",
  "version": "0.1.0",
  "description": "See every port your Mac is listening on, what started it, and stop it safely. Menu bar app + CLI.",
  "keywords": [
    "ports",
    "port",
    "localhost",
    "dev-server",
    "kill-port",
    "menu-bar",
    "tray",
    "macos",
    "docker",
    "cli",
    "lsof",
    "netstat"
  ],
  "license": "MIT",
  "author": "Abdul Hadi Waseem",
  "homepage": "https://github.com/Abdul-Hadi-Waseem/portlight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdul-Hadi-Waseem/portlight.git"
  },
  "bugs": {
    "url": "https://github.com/Abdul-Hadi-Waseem/portlight/issues"
  },
  "type": "module",
  "bin": {
    "portlight": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "assets/tray-icon.png",
    "assets/tray-icon.ico"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "npm run build && node dist/src/cli/main.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@trayjs/trayjs": "0.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
